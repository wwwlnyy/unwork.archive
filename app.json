{
  "expo": {
    "name": "unwork.archive",
    "slug": "unwork-archive",
    "scheme": "scrapapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wwwlnyy.x2026UnithonScrapApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wwwlnyy.x2026UnithonScrapApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "disableAndroid": true
        }
      ],
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ],
          "backgroundColor": {
            "red": 255,
            "green": 255,
            "blue": 255,
            "alpha": 1
          },
          "height": 220
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.325265117449-9omb1jnqqguk6rk28pt1rai6msonnckv"
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "unworkarchiveShareExtension",
                  "bundleIdentifier": "com.wwwlnyy.x2026UnithonScrapApp.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.wwwlnyy.x2026UnithonScrapApp"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f1bbcfd7-8c39-45e0-acf8-1c4d7c5be476"
      },
      "appleApplicationGroup": "group.com.wwwlnyy.x2026UnithonScrapApp"
    }
  }
}
